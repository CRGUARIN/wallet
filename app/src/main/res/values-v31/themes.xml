        <item name="windowSplashScreenBackground">@color/splash_dynamic_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_dynamic</item>
        <item name="postSplashScreenTheme">@style/Theme.Wallet</item>
    </style>
</resources>
