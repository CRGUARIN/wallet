<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Wallet" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Tema de arranque: muestra el splash mientras cargan las preferencias y luego pasa a Theme.Wallet. -->
    <style name="Theme.Wallet.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Wallet</item>
    </style>

    <!-- Splash verde fijo: Android 13+ lo usa en los siguientes arranques si se desactiva el color dinámico. -->
    <style name="Theme.Wallet.Starting.Green">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
